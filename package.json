{
  "name": "modbus-engineering-analyzer",
  "version": "7.0.0",
  "description": "Intelligent Modbus RTU/TCP reverse-engineering analyzer with automatic device formation, polling-cycle reconstruction, register inference, fingerprints, relationships, anomalies, persistent projects and desktop packaging.",
  "main": "src/index-v7.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index-v7.js",
    "ports": "node src/index-v7.js --list-ports",
    "demo": "node src/index-v7.js --demo",
    "v8:dev": "node src/index-v8-dev.js",
    "test": "node --test",
    "lint": "eslint .",
    "check:v8": "node scripts/check-v8-syntax.js",
    "version:check": "node scripts/version-sync.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run version:check && npm run lint && npm run check:v8",
    "smoke": "node scripts/smoke.js",
    "acceptance": "node scripts/acceptance.js",
    "soak": "node scripts/soak.js",
    "field-check": "node scripts/field-check.js",
    "discover": "node scripts/discover.js",
    "e2e": "playwright test",
    "desktop:install": "npm --prefix desktop install",
    "desktop": "npm --prefix desktop start",
    "desktop:win": "npm --prefix desktop run dist:win"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0"
  },
  "license": "MIT"
}
