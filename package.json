{
  "name": "modbus-engineering-analyzer",
  "version": "8.0.0",
  "description": "Advanced Modbus engineering tool for passive analysis, active Master testing, Slave simulation, discovery, LAB validation and evidence.",
  "main": "src/index-v7.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index-v7.js",
    "sniffer": "node src/index-v7.js",
    "workbench": "node src/index-v7.js",
    "v8": "node src/index-v7.js",
    "v7": "node src/index-v7.js",
    "ports": "node src/index-v7.js --list-ports",
    "demo": "node src/index-v7.js --demo",
    "test": "node scripts/run-root-tests.js",
    "lint": "eslint .",
    "check:v8": "node scripts/check-v8-syntax.js",
    "version:check": "node scripts/version-sync.js",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run version:check && npm run audit:source && npm run lint && npm run check:syntax && npm run check:v8",
    "benchmark:v8": "node scripts/benchmark-v8.js",
    "smoke": "node scripts/smoke.js",
    "acceptance": "node scripts/acceptance.js",
    "soak": "node scripts/soak.js",
    "soak:v8": "node scripts/soak-v8.js",
    "release:gate:mac": "bash scripts/release-gate-mac.sh",
    "field-check": "node scripts/field-check.js",
    "discover": "node scripts/discover.js",
    "e2e": "npm run e2e:unified && npm run e2e:compat",
    "desktop:install": "npm --prefix desktop install",
    "desktop": "npm --prefix desktop start",
    "desktop:win": "npm --prefix desktop run dist:win",
    "preflight": "node scripts/source-preflight.js",
    "audit:source": "node scripts/static-release-audit.js",
    "e2e:unified": "playwright test --config=playwright.unified.config.js",
    "e2e:compat": "playwright test --config=playwright.compat.config.js",
    "check:syntax": "node scripts/check-js-syntax.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "eslint": "^9.35.0"
  },
  "license": "MIT"
}
