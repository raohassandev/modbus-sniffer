{
  "name": "modbus-engineering-analyzer",
  "version": "6.2.0",
  "description": "Transport-aware Modbus RTU/TCP engineering analyzer with isolated channels, persistent projects, register maps, history, diagnostics and desktop packaging.",
  "main": "src/index-v6.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index-v6.js",
    "ports": "node src/index-v6.js --list-ports",
    "demo": "node src/index-v6.js --demo",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "acceptance": "node scripts/acceptance.js",
    "soak": "node scripts/soak.js",
    "field-check": "node scripts/field-check.js",
    "discover": "node scripts/discover.js",
    "e2e": "playwright test",
    "desktop:install": "npm --prefix desktop install",
    "desktop": "npm --prefix desktop start",
    "desktop:win": "npm --prefix desktop run dist:win"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "archiver": "^7.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdfkit": "^0.17.2",
    "serialport": "^13.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "license": "MIT"
}
