{
  "name": "modbus-engineering-analyzer-desktop",
  "version": "8.0.0",
  "description": "Windows desktop shell for the unified Modbus Engineering Tool.",
  "author": "Automatrix Engineering",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pk.automatrix.modbus-analyzer",
    "productName": "Modbus Engineering Tool",
    "artifactName": "Modbus-Engineering-Tool-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "storage.js",
      "logSafety.js",
      "navigationSafety.js"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "backend/src",
        "filter": [
          "**/*",
          "!index-v8.js"
        ]
      },
      {
        "from": "../public",
        "to": "backend/public",
        "filter": [
          "**/*",
          "!v8/**"
        ]
      },
      {
        "from": "../config",
        "to": "backend/config"
      },
      {
        "from": "../node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../package.json",
        "to": "backend/package.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
